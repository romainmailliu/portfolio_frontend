# Copier vers `.env.local` pour le dev local (Next.js ne lit PAS ce fichier).
# --- Dashboard privé (/admin) ---
DASHBOARD_PASSWORD=
# Chaîne longue aléatoire ; openssl rand -hex 32 — signe les cookies de session (la changer déconnecte tout le monde).
DASHBOARD_SESSION_SECRET=

# Host par défaut (repli pour ATS / Amidou / Gomett / Coexister / Portfolio si *_<SUFFIX> absents)
POSTHOG_HOST=https://eu.posthog.com

# --- Carte « ATS Seduction » (suffixe ATS_SEDUCTION) ---
POSTHOG_PROJECT_ID_ATS_SEDUCTION=
POSTHOG_API_KEY_ATS_SEDUCTION=
POSTHOG_HOST_ATS_SEDUCTION=https://eu.posthog.com
GSC_SITE_URL_ATS_SEDUCTION=https://ats-seduction.vercel.app/
# Anciens noms encore lus si les *_ATS_SEDUCTION ci-dessus sont vides :
# POSTHOG_PROJECT_ID_ATS=
# GSC_SITE_URL_ATS=

# --- Carte « Amidou » — autre compte PostHog (suffixe AMIDOU, pas de repli sur POSTHOG_API_KEY) ---
POSTHOG_PROJECT_ID_AMIDOU=
POSTHOG_API_KEY_AMIDOU=
POSTHOG_HOST_AMIDOU=https://eu.posthog.com
GSC_SITE_URL_AMIDOU=https://www.amidou.eu/

# --- Carte « Gomett » (suffixe GOMETT) ---
POSTHOG_PROJECT_ID_GOMETT=
POSTHOG_API_KEY_GOMETT=
POSTHOG_HOST_GOMETT=https://eu.posthog.com
GSC_SITE_URL_GOMETT=https://www.gomett.com/

# --- Carte « Coexister » (suffixe COEXISTER) ---
POSTHOG_PROJECT_ID_COEXISTER=
POSTHOG_API_KEY_COEXISTER=
POSTHOG_HOST_COEXISTER=https://eu.posthog.com
GSC_SITE_URL_COEXISTER=https://www.coexister.fr/

# --- Carte « Annuaire La Ruche » (suffixe ANNUAIRE_LA_RUCHE) ---
# Clé personnelle PostHog avec permission « Query read » (User settings → Personal API keys).
# À dupliquer sur Vercel (Production) avec les mêmes noms.
POSTHOG_PROJECT_ID_ANNUAIRE_LA_RUCHE=
POSTHOG_API_KEY_ANNUAIRE_LA_RUCHE=
POSTHOG_HOST_ANNUAIRE_LA_RUCHE=https://eu.posthog.com
GSC_SITE_URL_ANNUAIRE_LA_RUCHE=

# --- Carte « Portfolio » (sans suffixe — utilise uniquement POSTHOG_API_KEY) ---
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID_PORTFOLIO=

# URL publique du site (lien « Site » sur le dashboard) — ancien préfixe GSC_SITE_URL_*
GSC_SITE_URL_PORTFOLIO=https://www.romainmailliu.com/
