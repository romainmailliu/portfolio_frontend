# Copier vers `.env.local` pour le dev local (Next.js ne lit PAS ce fichier).
# --- Dashboard privé (/admin) ---
DASHBOARD_PASSWORD=
# Chaîne longue aléatoire ; openssl rand -hex 32 — signe les cookies de session (la changer déconnecte tout le monde).
DASHBOARD_SESSION_SECRET=

# --- PostHog : une carte /admin par projet ---
# Une seule clé personnelle (phx_, scope « query:read ») couvre toutes les
# organisations du compte. Une clé dédiée reste possible par carte via
# POSTHOG_API_KEY_<SUFFIX> (obligatoire pour Amidou, autre compte PostHog).
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
# Project ID : PostHog → Project settings → Project ID.
# GSC_SITE_URL_<SUFFIX> ne sert qu'au lien « Site » de la carte (valeur par
# défaut dans src/config/analytics-sites.ts).

POSTHOG_PROJECT_ID_ATS_SEDUCTION=
GSC_SITE_URL_ATS_SEDUCTION=https://ats-seduction.vercel.app/
# Ancien nom encore lu si vide : POSTHOG_PROJECT_ID_ATS

POSTHOG_PROJECT_ID_GOMETT=
GSC_SITE_URL_GOMETT=https://www.gomett.com/

POSTHOG_PROJECT_ID_COEXISTER=
GSC_SITE_URL_COEXISTER=https://www.coexister.fr/

POSTHOG_PROJECT_ID_ANNUAIRE_LA_RUCHE=
GSC_SITE_URL_ANNUAIRE_LA_RUCHE=https://annuaire-transforama-la-ruche.vercel.app/

POSTHOG_PROJECT_ID_KLINK=
GSC_SITE_URL_KLINK=https://www.lesonduvin.fr/

POSTHOG_PROJECT_ID_LEVAT=
GSC_SITE_URL_LEVAT=https://www.assolevat.fr/

POSTHOG_PROJECT_ID_ALBANE=
GSC_SITE_URL_ALBANE=https://www.albanedharcourt.com/

POSTHOG_PROJECT_ID_LA_CAMARADERIE=
GSC_SITE_URL_LA_CAMARADERIE=https://www.lacamaraderie.net/

POSTHOG_PROJECT_ID_RIVIERE=
GSC_SITE_URL_RIVIERE=https://www.rivieredereves.org/

POSTHOG_PROJECT_ID_PORTFOLIO=
GSC_SITE_URL_PORTFOLIO=https://www.romainmailliu.com/

# Amidou — autre compte PostHog : clé dédiée obligatoire, aucun repli sur POSTHOG_API_KEY.
POSTHOG_PROJECT_ID_AMIDOU=
POSTHOG_API_KEY_AMIDOU=
POSTHOG_HOST_AMIDOU=https://eu.posthog.com
GSC_SITE_URL_AMIDOU=https://www.amidou.eu/

# --- Envoi des formulaires (Resend) ---
# Clé API Resend — domaine `romainmailliu.com` vérifié. À dupliquer sur Vercel
# (Production + Preview), sinon les formulaires journalisent au lieu d'envoyer.
RESEND_API_KEY=
# Destinataire des notifications. Vide = romain.mailliu@gmail.com.
LEADS_NOTIFICATION_EMAIL=

# --- Analytics du portfolio (PostHog, côté visiteur + serveur) ---
# Token public du projet PostHog « Portfolio ». À dupliquer sur Vercel
# (Production + Preview) ; sans lui, aucun événement n'est envoyé.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
